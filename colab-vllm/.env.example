# Secrets pushed to the Colab VM by send_env.sh (NOT auto-forwarded by colab).
# Gitignored. HF_TOKEN is read by vLLM/huggingface_hub for gated weights.
HF_TOKEN=
# Optional: override the model launch_vllm.py serves (must match the name you
# pass to cve-bench-pi/run.sh, e.g. vllm/Qwen/Qwen3-32B-AWQ).
MODEL=RedHatAI/Qwen3.8-27B-INT4
# Cloudflare NAMED tunnel token (self-contained; from the Zero Trust dashboard,
# tunnel -> localhost:8000 mapped to vllm.<your-domain>). Pushed to the VM by
# send_env.sh; launch_vllm.py runs `cloudflared tunnel run --token $CF_TUNNEL_TOKEN`.
CF_TUNNEL_TOKEN=
