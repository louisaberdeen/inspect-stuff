# Copy to .env. Inspect relays pi's calls to THIS model from the host (container stays offline).
# Colab tunnel URL changes each launch — update after relaunching vLLM.
VLLM_BASE_URL=https://<your-tunnel>.trycloudflare.com/v1
VLLM_API_KEY=my-secret-token
INSPECT_EVAL_MODEL=vllm/Qwen/Qwen2.5-7B-Instruct
