# Proxmox API: values printed by vend.sh (see PROXMOX.md). Keep .env out of git.
PROXMOX_HOST=127.0.0.1
PROXMOX_PORT=11001
PROXMOX_USER=root
PROXMOX_REALM=pam
PROXMOX_PASSWORD=changeme
PROXMOX_NODE=proxmox
PROXMOX_VERIFY_TLS=0
PROXMOX_IMAGE_STORAGE=local

# Colab vLLM: fixed Cloudflare named-tunnel endpoint (same tunnel as cve-bench-pi),
# set once. CF_TUNNEL_TOKEN launches the connector on the VM (see colab-vllm/RUN.md).
VLLM_BASE_URL=https://vllm.<your-domain>/v1
VLLM_API_KEY=my-secret-token
CF_TUNNEL_TOKEN=

# Optional: gated HF weights / datasets
# HF_TOKEN=hf_...
